# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo del lado del servidor (cron de alertas). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dominios de mail que pueden entrar, separados por coma. Vacío = cualquiera.
ALLOWED_EMAIL_DOMAINS=modusretis.com

# Dictado por voz: Claude ordena lo dictado en tareas. Sin clave, el dictado igual
# funciona pero carga el texto tal cual como una sola tarea.
ANTHROPIC_API_KEY=

# Cron de alertas (Vercel lo manda como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=un-texto-largo-al-azar

# Mails de alertas (opcional) — https://resend.com
RESEND_API_KEY=
ALERTS_FROM_EMAIL=Planning Modus Retis <planning@modusretis.com>
# URL pública de la app, para los links de los mails
APP_URL=https://planning-modusretis.vercel.app

# ---------------- Publicación automática en redes (ver GUIA_REDES.md)
# Instagram (developers.facebook.com → tu app → Instagram → API con inicio de sesión de Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# LinkedIn (linkedin.com/developers → tu app → Auth), con el producto Community Management API aprobado
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok (developers.tiktok.com → tu app). TIKTOK_MODE: inbox (a borradores) o direct (cuando TikTok apruebe la auditoría)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MODE=inbox
# Mail de contacto que aparece en /privacidad y /terminos (lo piden las redes)
LEGAL_CONTACT_EMAIL=

# ---------------- Resúmenes mensuales (pestaña Resúmenes, se leen de ClickUp)
# ClickUp → avatar → Configuración → Apps → API Token (pk_…). Ve lo mismo que ve esa persona en ClickUp.
CLICKUP_API_TOKEN=
# El número que aparece en las URL de ClickUp: app.clickup.com/<este número>/…
CLICKUP_WORKSPACE_ID=9002139524
# Opcional: tareas cuyas subtareas son resúmenes, separadas por coma (WEGA no se muestra nunca)
CLICKUP_SUMMARY_TASKS=

# ---------------- Tareas desde reuniones de Granola (pop-up al entrar y botón "📝 De reuniones" en Tareas)
# Granola (app de escritorio) → Settings → API → crear clave personal (grn_…). Necesita plan Business o Enterprise;
# en Enterprise, un admin del workspace tiene que habilitar las claves personales.
GRANOLA_API_KEY=
# Quién ve el pop-up (los mails de la app, separados por coma). Vacío = los admins.
GRANOLA_USERS=c.forgione@modusretis.com
# Solo reuniones cuyo título empieza con este prefijo ("MR Lytton + Coni 30/10")
GRANOLA_PREFIX=MR
# …y que nombren a alguna de estas personas (alcanza con el comienzo del nombre: "viole" = Viole o Violeta)
GRANOLA_PEOPLE=lytton,mauri,barbi,viole,yani
# Cuántos días para atrás se buscan reuniones nuevas
GRANOLA_DAYS=21
# Con ANTHROPIC_API_KEY los puntos de acción los arma Claude (mejor); sin clave, se leen de "Próximos pasos" y pendientes.
