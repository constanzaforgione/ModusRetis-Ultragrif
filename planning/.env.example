# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo del lado del servidor (cron de alertas). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dominios de mail que pueden entrar, separados por coma. Vacío = cualquiera.
ALLOWED_EMAIL_DOMAINS=modusretis.com

# Dictado por voz: Claude ordena lo dictado en tareas. Sin clave, el dictado igual
# funciona pero carga el texto tal cual como una sola tarea.
ANTHROPIC_API_KEY=

# Cron de alertas (Vercel lo manda como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=un-texto-largo-al-azar

# Mails de alertas (opcional) — https://resend.com
RESEND_API_KEY=
ALERTS_FROM_EMAIL=Planning Modus Retis <planning@modusretis.com>
# URL pública de la app, para los links de los mails
APP_URL=https://planning-modusretis.vercel.app
